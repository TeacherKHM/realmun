# Copia este archivo como .env.local y llena los valores.
# Dashboard de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_publishable_key

# Clave secreta del servidor (Project Settings → API Keys → secret key, sb_secret_…).
# Solo la usan las server actions: cambiar contraseñas de comités y limitar intentos.
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni subirse al repositorio.
SUPABASE_SECRET_KEY=sb_secret_tu_clave

# Opcional: sal para hashear IP y correo en la tabla de intentos.
# LOGIN_HASH_SALT=una-cadena-larga-y-aleatoria

# Opcional: captcha de Cloudflare Turnstile (requiere activarlo también en
# Supabase → Authentication → Attack Protection, con la misma llave secreta).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_site_key
